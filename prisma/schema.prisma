generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductCategory {
  COMIDA
  TRAGO
}

model Guest {
  id           String        @id @default(cuid())
  name         String
  createdAt    DateTime      @default(now())
  consumptions Consumption[]
  exchanges    Exchange[]
}

model Product {
  id           String          @id @default(cuid())
  name         String
  price        Int
  category     ProductCategory @default(COMIDA)
  createdAt    DateTime        @default(now())
  consumptions Consumption[]
}

model Prize {
  id        String     @id @default(cuid())
  name      String
  price     Int // costo en Duro Puntos
  createdAt DateTime   @default(now())
  exchanges Exchange[]
}

model Consumption {
  id        String   @id @default(cuid())
  guestId   String
  productId String
  createdAt DateTime @default(now())
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([guestId])
  @@index([productId])
}

// Registro de qué invitado canjeó qué premio. Los Duro Puntos disponibles se
// calculan siempre desde acá (ganados por consumo menos gastados en canjes),
// nunca como un contador guardado: así un canje nunca se "revierte" solo
// porque después se registre otra compra.
model Exchange {
  id        String   @id @default(cuid())
  guestId   String
  prizeId   String
  createdAt DateTime @default(now())
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  prize     Prize    @relation(fields: [prizeId], references: [id], onDelete: Cascade)

  @@index([guestId])
  @@index([prizeId])
}
